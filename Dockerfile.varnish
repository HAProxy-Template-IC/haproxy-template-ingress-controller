# syntax=docker/dockerfile:1
FROM varnish:9.1@sha256:842a2874f49d5b9eb7690a8fe0b6d3a66d8045b2d2a96154b4a804e2cbd8ac33

# Non-root exec needs a file capability to retain the Pod's IPC_LOCK grant.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && setcap cap_ipc_lock=ep /usr/sbin/varnishd \
    && rm -rf /var/lib/apt/lists/*
USER 1000:1000
