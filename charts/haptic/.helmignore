# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Chart-level documentation (mkdocs site source, not needed for install).
# These files are rendered into the project's Pages site separately;
# packaging them inflates the Helm release Secret toward the K8s 1 MiB limit.
docs/
mkdocs.yml
# Chart-level CHANGELOG and README — informational, not chart-functional.
CHANGELOG.md
README.md
