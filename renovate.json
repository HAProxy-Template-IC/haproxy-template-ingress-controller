{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separateMajorReleases",
    "customManagers:dockerfileVersions",
    "customManagers:gitlabPipelineVersions",
    "customManagers:makefileVersions",
    "customManagers:helmChartYamlAppVersions"
  ],
  "labels": [
    "dependencies"
  ],
  "platformAutomerge": true,
  "prHourlyLimit": 10,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "HAProxy pinned-patch image tags in dev-env manifests. Series-locked: the major.minor is captured from the current tag and baked into the versioning regex, so each manifest stays within its own series.",
      "fileMatch": [
        "^scripts/dev-env-assets/haproxy-.*\\.yaml$"
      ],
      "matchStrings": [
        "haproxytech/haproxy-debian:(?<currentValue>(?<seriesMajor>\\d+)\\.(?<seriesMinor>\\d+)\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "haproxy-debian {{{seriesMajor}}}.{{{seriesMinor}}}.x",
      "packageNameTemplate": "haproxytech/haproxy-debian",
      "versioningTemplate": "regex:^(?<major>{{{seriesMajor}}})\\.(?<minor>{{{seriesMinor}}})\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "HAProxy patch versions in charts/haptic/values.yaml. Each entry's series (captured from the YAML key) is baked into a per-dep regex versioning scheme, so Renovate only considers patches within the same series. Adding or removing a series requires no renovate.json change.",
      "fileMatch": [
        "^charts/haptic/values\\.yaml$"
      ],
      "matchStrings": [
        "# renovate:\\s*datasource=docker\\s+depName=haproxytech/haproxy-debian[^\\n]*\\n\\s*\"(?<seriesMajor>\\d+)\\.(?<seriesMinor>\\d+)\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "haproxy-debian {{{seriesMajor}}}.{{{seriesMinor}}}.x",
      "packageNameTemplate": "haproxytech/haproxy-debian",
      "versioningTemplate": "regex:^(?<major>{{{seriesMajor}}})\\.(?<minor>{{{seriesMinor}}})\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge patch and minor updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge Go patch and minor",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Update Go version in go.mod",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group Go version updates from go.mod and .tool-versions",
      "matchManagers": [
        "gomod",
        "asdf"
      ],
      "matchDepNames": [
        "go",
        "golang"
      ],
      "groupName": "go version"
    },
    {
      "description": "Group Kubernetes dependencies",
      "groupName": "kubernetes packages",
      "matchPackageNames": [
        "k8s.io/{/,}**",
        "sigs.k8s.io/{/,}**"
      ]
    },
    {
      "description": "Group linter dependencies",
      "groupName": "linting tools",
      "matchPackageNames": [
        "/golangci/",
        "/staticcheck/"
      ]
    },
    {
      "description": "Group HAProxy dependencies",
      "groupName": "haproxy packages",
      "matchPackageNames": [
        "github.com/haproxytech/{/,}**"
      ]
    },
    {
      "description": "Group all HAProxy image/patch bumps into a single MR per run",
      "matchPackageNames": [
        "haproxytech/haproxy-debian"
      ],
      "groupName": "haproxy image"
    }
  ]
}
