# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Project-specific binaries
/controller
integration.test
*.test

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.txt
coverage.xml

# CI-generated report files
gl-code-quality-report.json
report*.xml

# Go workspace file
go.work
go.work.sum

# Build artifacts
/bin/
/build/
/dist/

# Dependency directories
/vendor/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
*.bak
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log
*.pid
*.seed
*.gz

# Local environment and configuration
.env
.env.*
!.env.example
*.local
*.local.json
kubeconfig
kubeconfig.*

# Kind cluster artifacts
.kind/

# Cache directories
.cache/
.go-cache/

# Debug files
__debug_bin

# Air (live reload) temporary files
tmp/

# Copied shared CSS files (source of truth is docs/shared/colors.css)
docs/site/docs/stylesheets/colors.css

# mkdocs build output (each docs/* and charts/*/docs sub-tree builds to its own site/)
docs/*/site/
charts/*/site/

# Test failure diagnostic artifacts (tests/e2e/cleanup.go writes here)
debug-logs/

# Scale-tier measurement output (tests/e2e/scale_test.go writes it to the
# repo root; the nightly-scale CI job uploads it as an artifact)
scale-metrics.json

# Generated by ad-hoc `helm dependency` runs; the subcharts are vendored
# source directories, so the lock pins nothing and only goes stale
charts/haptic/Chart.lock

# Browser playground build output (scripts/build-playground.sh writes the bundle
# to public/playground/<version>/; `go build ./cmd/playground` drops a stray
# `playground` binary at the repo root; the Help modal suggests a local
# playground-local/ serve dir)
/public/
/playground
/playground-local/

# Claude Code working files
.claude/
plugins/

# Serena MCP server working files
.serena/
__pycache__/
