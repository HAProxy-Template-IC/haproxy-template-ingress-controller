# versions-spoa.env — pinned versions for the bundled SPOA hub image.
#
# This file is sourced by CI to download the hub binary + plugin .so files
# from each upstream project's GitLab Generic Package Registry. The
# `docs/controller/docs/operations/spoa-hub.md` page is auto-generated
# from this file and CI fails if the rendered output drifts.
#
# Each version string is the upstream git tag (with leading `v`) and
# matches the path segment inside that project's Generic Package Registry
# at `packages/generic/<pkg>/<tag>/`.

# renovate: datasource=gitlab-packages packageName=haproxy-haptic/haproxy-spoa-hub:spoa-hub registryUrl=https://gitlab.com depName=spoa-hub
# v0.5.3 parallelises plugin dispatch within a validator request: the
# orchestrator now spawns one scoped thread per `[[plugins]]` entry
# instead of looping serially, so per-request wall-clock is `max` of
# per-plugin times rather than `sum`. Matters under admission load
# when multiple plugins carry non-trivial `validate()` overrides
# (notably coraza's SecLang FFI compile). v0.5.2 added the central
# `--validate-socket` schema-check before plugin.validate() dispatch.
SPOA_HUB_VERSION="v0.5.3"

# renovate: datasource=gitlab-packages packageName=haproxy-haptic/haproxy-spoa-hub-plugin-coraza:coraza registryUrl=https://gitlab.com depName=coraza
# v0.4.2 routes `validate()` through the same `PluginConfig::from_context`
# the runtime parser uses, collapsing the prior schema drift between
# init() (table-keyed-by-name `applications`) and validate() (legacy
# array shape) into a single source of truth. With hub v0.5.2's
# central schema-check this is belt-and-braces: even a plugin author
# who forgets the DRY discipline can't bypass admission anymore.
# v0.4.1 fixed the OnceLock-on-reload bug that left post-reload
# requests serving against the freed first-init WAF handle.
SPOA_PLUGIN_CORAZA_VERSION="v0.4.2"

# renovate: datasource=gitlab-packages packageName=haproxy-haptic/haproxy-spoa-hub-plugin-external-auth:external-auth registryUrl=https://gitlab.com depName=external-auth
SPOA_PLUGIN_EXTERNAL_AUTH_VERSION="v0.4.0"

# renovate: datasource=gitlab-packages packageName=haproxy-haptic/haproxy-spoa-hub-plugin-fingerprinting:fingerprinting registryUrl=https://gitlab.com depName=fingerprinting
SPOA_PLUGIN_FINGERPRINTING_VERSION="v0.2.0"

# renovate: datasource=gitlab-packages packageName=haproxy-haptic/haproxy-spoa-hub-plugin-maxmind:maxmind registryUrl=https://gitlab.com depName=maxmind
SPOA_PLUGIN_MAXMIND_VERSION="v0.3.0"

# renovate: datasource=gitlab-packages packageName=haproxy-haptic/haproxy-spoa-hub-plugin-otel:otel registryUrl=https://gitlab.com depName=otel
SPOA_PLUGIN_OTEL_VERSION="v0.3.0"

# renovate: datasource=gitlab-packages packageName=haproxy-haptic/haproxy-spoa-hub-plugin-sso-auth:sso-auth registryUrl=https://gitlab.com depName=sso-auth
SPOA_PLUGIN_SSO_AUTH_VERSION="v0.2.0"

# Glibc version stamped into upstream plugin .so filenames. Tracks the
# upstream build base (Debian bookworm rust:1.94-bookworm builder image).
# Bump in lockstep with upstream when their build base shifts.
SPOA_PLUGIN_GLIBC_VERSION="2.36"
