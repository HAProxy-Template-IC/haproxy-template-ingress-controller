# versions.env - HAProxy version configuration
# This file is sourced by CI and scripts to centralize version management
#
# To add or remove a supported HAProxy series, update HAPROXY_VERSIONS below, the
# chart's haproxyVersion enum and patch maps, ci/build-pins.yml, .goreleaser.yml,
# and the per-series CI jobs. `make lint` checks the chart and pins against it.

# Supported HAProxy versions (space-separated)
HAPROXY_VERSIONS="3.0 3.2 3.3 3.4"

# Default HAProxy version used by chart and release scripts.
# Clamped to stable series by a packageRule in renovate.json (skip series that
# only exist as dev releases on Docker Hub).
# renovate: datasource=docker depName=haproxytech/haproxy-debian versioning=loose
DEFAULT_HAPROXY="3.4"

# Enterprise version mappings (for dev environment)
HAPROXY_ENTERPRISE_30="3.0r1"
HAPROXY_ENTERPRISE_32="3.2r1"
# HAPROXY_ENTERPRISE_33 - pending HAProxy Enterprise 3.3 release
# HAPROXY_ENTERPRISE_34 - pending HAProxy Enterprise 3.4 release
