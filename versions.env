# versions.env - HAProxy version configuration
# This file is sourced by CI and scripts to centralize version management
#
# To add/remove a supported HAProxy version, update HAPROXY_VERSIONS below.
# All CI jobs, scripts, and release pipelines will automatically use the new list.

# Supported HAProxy versions (space-separated)
HAPROXY_VERSIONS="3.0 3.1 3.2 3.3"

# Default HAProxy version used by chart and release scripts.
# extractVersion derives the version from patch tags (X.Y.Z → X.Y) so Renovate
# never proposes a series that only has dev releases (no stable X.Y.Z yet).
# renovate: datasource=docker depName=haproxytech/haproxy-debian extractVersion=^(?<version>\d+\.\d+)\. versioning=loose
DEFAULT_HAPROXY="3.2"

# Enterprise version mappings (for dev environment)
HAPROXY_ENTERPRISE_30="3.0r1"
HAPROXY_ENTERPRISE_31="3.1r1"
HAPROXY_ENTERPRISE_32="3.2r1"
# HAPROXY_ENTERPRISE_33 - pending HAProxy Enterprise 3.3 release
